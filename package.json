{
  "name": "thoranam-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Thoranam backend infrastructure foundation",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check src test scripts *.json *.ts *.mjs *.yaml Dockerfile README.md .env.example .nvmrc .prettierrc.json --ignore-unknown",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test dist-test/test/*.integration.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.9",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
